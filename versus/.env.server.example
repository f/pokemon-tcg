# Local development only. Copy to .env.server for `sf dev`, then open the app with ?guest=alice and ?guest=bob.
# `sf publish` uploads .env.server as secret Space variables and never removes one later, so delete .env.server (or
# this line) before publishing, run `npm run check-publish`, and check `sf env ls --space <id>` afterwards.
ALLOW_DEV_GUESTS=1
